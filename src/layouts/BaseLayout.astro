---
import { SECTIONS } from '../lib/sections';

interface Props {
  title?: string;
  description?: string;
  /**
   * MDX pages set `layout:` in their frontmatter, and Astro hands the layout
   * that frontmatter under this prop rather than spreading it into props. So
   * title and description are read from either place.
   */
  frontmatter?: { title?: string; description?: string };
}

const SITE_NAME = 'Pete';
// The page says it short; the description says it searchably. A shared link
// or a search result is read cold, with no site around it to supply context.
const DEFAULT_DESCRIPTION =
  'Problems from work and play, made playable: quantitative finance, operations research, and mathematics you can poke at in the browser.';

const { frontmatter } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title;
const description = Astro.props.description ?? frontmatter?.description ?? DEFAULT_DESCRIPTION;

// The home page titles itself; every other page is "<page> | Pete", which is
// how the title reads in a tab, a bookmark, or a search result.
const pageTitle = !title || title === 'Home' ? SITE_NAME : `${title} | ${SITE_NAME}`;

// Absolute for sharing, when a site URL is configured. Astro.site comes from
// `site` in astro.config.mjs; without it, og:url is simply omitted rather than
// emitted as a relative URL that no crawler can resolve.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// Crawlers want an absolute image URL, so the card only goes out when a site
// origin is configured. Regenerate it with `npm run og` if the tagline moves.
const shareImage = Astro.site ? new URL('/og.png', Astro.site).href : undefined;

// Section links, straight from the registry, so adding or retiring a section
// updates the nav without anyone remembering to. Marked current when the
// visitor is inside that section, including on its individual pages.
const path = Astro.url.pathname;
const navSections = SECTIONS.map((section) => ({
  href: `/${section.id}`,
  label: section.navTitle ?? section.title,
  current: path === `/${section.id}` || path.startsWith(`/${section.id}/`),
}));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />
    <title>{pageTitle}</title>

    {canonical && <link rel="canonical" href={canonical} />}

    {/* Shared links — Slack, Messages, social — render from these, not from
        the page body. Without them a link is just a bare URL. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && (
      <>
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/katex/katex.min.css" />
    <script is:inline>
      // The theme follows the operating system setting. CSS does this on its
      // own via prefers-color-scheme; the `dark` class exists so canvas and
      // p5 sketches can read the current mode from JS (see utils/darkMode.ts).
      // Inline and in <head> so the class is set before first paint.
      (() => {
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const apply = () => document.documentElement.classList.toggle('dark', media.matches);
        apply();
        media.addEventListener('change', apply);
      })();
    </script>
  </head>
  <body>
    <nav class="main-nav">
      <a href="/" class="nav-brand" aria-label={`${SITE_NAME} — home`} title="Home">
        {/* Three shrinking tangent circles: the Spiral Circles sketch reduced
            to a mark. A house glyph would say "home" and nothing else; this
            says home and also says what the site is. */}
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="8" cy="16" r="6" />
          <circle cx="17" cy="9.5" r="3.4" />
          <circle cx="21.4" cy="4.6" r="1.8" />
        </svg>
      </a>
      <div class="nav-sections">
        {navSections.map((section) => (
          <a href={section.href} aria-current={section.current ? 'page' : undefined}>
            {section.label}
          </a>
        ))}
      </div>

      <a
        class="nav-github"
        href="https://github.com/pbenson/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Pete on GitHub"
        title="GitHub"
      >
        {/* Inline so it costs no request and inherits currentColor in both themes. */}
        <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
        </svg>
      </a>
    </nav>
    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        Built by Pete. <a href="/about">About this site</a> ·
        <a href="https://github.com/pbenson/" rel="noopener noreferrer">GitHub</a> ·
        <a href="https://cherryarbordesign.pb0.dev" rel="noopener noreferrer">Cherry Arbor Design</a>
      </p>
    </footer>
  </body>
</html>

<style>
  .main-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    /* Tighter than it was: the bar used to be sized around a theme toggle that
       no longer exists, and every page paid for the empty height. */
    padding: 0.6rem 2rem;
    border-bottom: 1px solid var(--border-color);
    background: var(--nav-bg);
  }

  .nav-sections {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-right: auto;
  }

  .nav-sections a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.15s ease;
  }

  .nav-sections a:hover,
  .nav-sections a[aria-current='page'] {
    color: var(--accent-color);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    color: var(--text-color);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-brand:hover {
    color: var(--accent-color);
  }

  .nav-github {
    display: flex;
    align-items: center;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .nav-github:hover {
    color: var(--accent-color);
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  /* A visitor who arrives deep, on one page from a link, has nowhere to go at
     the bottom otherwise — this is where "whose is this?" gets answered. */
  .site-footer {
    max-width: 1200px;
    margin: var(--space-12) auto 0;
    padding: var(--space-6) 2rem var(--space-8);
    border-top: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--accent-color);
  }

  @media (max-width: 768px) {
    .main-nav {
      flex-wrap: wrap;
      gap: var(--space-3);
      padding: 0.6rem 1rem;
    }

    .site-footer {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .nav-sections {
      order: 3;
      width: 100%;
      justify-content: flex-start;
      gap: var(--space-3);
      margin-right: 0;
    }

    /* The section links drop to their own row, so the GitHub icon has to claim
       the right edge itself rather than inheriting it from them. */
    .nav-github {
      margin-left: auto;
    }

    main {
      padding: 1rem;
    }
  }
</style>
