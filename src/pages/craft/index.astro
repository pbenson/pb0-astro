---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardGrid from '../../components/ui/CardGrid.astro';
import { entriesBySection } from '../../lib/pages';
import { getSection } from '../../lib/sections';

const section = getSection('craft');
const entries = entriesBySection(section.id);
---

<BaseLayout title={section.title}>
  <h1>{section.title}</h1>
  <p class="description">{section.description}</p>

  <CardGrid entries={entries} />
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.5rem;
  }

  .description {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
</style>
